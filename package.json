{
  "name": "gg-sports-nature",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "GG Sports-Nature — station de préparation et d'aide à la décision pour les activités de plein air et nautiques",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "serve": "node server/serve.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "data:coastline": "node scripts/build-coastline.mjs"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "suncalc": "^1.9.0"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.14",
    "@types/leaflet": "^1.9.12",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/suncalc": "^1.9.2",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^4.3.4",
    "topojson-client": "^3.1.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "world-atlas": "^2.0.2"
  }
}
